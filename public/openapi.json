    "/api/reports/daily-sales/snapshot": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Daily sales snapshot (cached)",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
